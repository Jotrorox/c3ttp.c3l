module c3ttp;

faultdef
	INVALID_REQUEST_LINE,
	INVALID_HEADER,
	INVALID_VERSION,
	INVALID_METHOD,
	INVALID_TARGET,
	INVALID_CONTENT_LENGTH,
	DUPLICATE_HEADER,
	MISSING_HOST,
	CONFLICTING_BODY_HEADERS,
	UNSUPPORTED_TRANSFER_ENCODING,
	REQUEST_LINE_TOO_LARGE,
	HEADER_LINE_TOO_LARGE,
	TOO_MANY_HEADERS,
	HEADERS_TOO_LARGE,
	BODY_TOO_LARGE,
	BUFFER_TOO_SMALL,
	INVALID_INPUT_BUFFER,
	CONNECTION_CLOSED,
	BACKEND_UNAVAILABLE,
	ROUTE_PARAM_NOT_FOUND;

const usz MAX_VIEW_HEADERS = 64;
const usz MAX_BODY_CHUNKS = 64;

enum Method : char
{
	GET,
	POST,
	PUT,
	DELETE,
	HEAD,
	OPTIONS,
	PATCH,
	CONNECT,
	TRACE,
	OTHER,
}

enum HeaderId : char
{
	UNKNOWN,
	HOST,
	CONTENT_LENGTH,
	CONNECTION,
	TRANSFER_ENCODING,
	CONTENT_TYPE,
	ACCEPT,
	AUTHORIZATION,
	COOKIE,
	USER_AGENT,
}

enum ParseState : char
{
	REQUEST_LINE,
	HEADERS,
	BODY_FIXED,
	CHUNK_SIZE,
	CHUNK_DATA,
	TRAILERS,
	COMPLETE,
}

enum ParseStatus : char
{
	NEED_MORE,
	COMPLETE,
}

enum ServerBackend : char
{
	AUTO,
	IO_URING,
	POLL,
}

struct Limits
{
	usz max_request_line;
	usz max_header_line;
	usz max_header_bytes;
	usz max_body_bytes;
	usz max_headers;
}

struct HeaderView
{
	String name;
	String value;
	HeaderId id;
}

struct RequestView
{
	String method;
	String target;
	String version;
	String body;
	Method method_id;
	HeaderView[MAX_VIEW_HEADERS] header_storage;
	String[MAX_BODY_CHUNKS] chunk_storage;
	usz header_count;
	usz chunk_count;
	usz message_length;
	usz content_length;
	usz body_length;
	bool has_content_length;
	bool chunked;
	bool keep_alive;
}

struct RequestParser
{
	Limits limits;
	ParseState state;
	RequestView request;
	usz cursor;
	usz line_start;
	usz header_bytes;
	usz chunk_remaining;
	uptr buffer_address;
	usz observed_length;
	bool saw_host;
	bool saw_transfer_encoding;
}

struct ServerOptions
{
	ServerBackend backend;
	Limits limits;
	uint workers;
	uint backlog;
	usz connections_per_worker;
	usz buffer_size;
	bool pin_workers;
	bool tcp_no_delay;
}

struct ResponseView
{
	ushort status;
	String content_type;
	String body;
	bool close;
}

alias ViewHandler = fn void?(RequestView* request, ResponseView* response, void* context);

macro Limits default_limits() => default_limits_impl();
macro ServerOptions default_server_options() => default_server_options_impl();

macro RequestParser* RequestParser.init(&self, Limits limits = default_limits())
	=> request_parser_init_impl(self, limits);
macro void RequestParser.reset(&self)
	=> request_parser_reset_impl(self);
macro ParseStatus? RequestParser.parse(&self, char[] input)
	=> request_parser_parse_impl(self, input);

macro HeaderView[] RequestView.headers(&self)
	=> self.header_storage[:self.header_count];
macro String[] RequestView.body_chunks(&self)
	=> self.chunk_storage[:self.chunk_count];
macro String? RequestView.header(&self, HeaderId id)
	=> request_view_header_impl(self, id);
macro String? RequestView.header_name(&self, String name)
	=> request_view_header_name_impl(self, name);

macro void ResponseView.ok(&self, String body = "", String content_type = "text/plain; charset=utf-8")
	=> response_view_set_impl(self, 200, body, content_type);
macro void ResponseView.set(&self, ushort status, String body = "", String content_type = "text/plain; charset=utf-8")
	=> response_view_set_impl(self, status, body, content_type);

macro void? serve(String host, uint port, ViewHandler handler, void* context = null, ServerOptions options = default_server_options())
	=> serve_impl(host, port, handler, context, options);
macro bool io_uring_available()
	=> io_uring_available_impl();

// Friendly names retain the exact layout and lifetimes of the zero-copy views.
alias Request = RequestView;
alias Response = ResponseView;

// Route metadata is read at compile time; nothing is stored on the request.
struct RouteConfig
{
	Method method;
	String path;
}

attrdef @Route(RouteConfig config) = @tag("c3ttp:route", config);

// Turn a declaration into an explicit compile-time route triple.
// Use alongside { Method, path, &handler } in a flat @server registration.
macro @route(#handler)
{
	$assert $defined($reflect(#handler).has_tag("c3ttp:route")) : "@route expects an annotated function name, not a function pointer";
	$assert $reflect(#handler).has_tag("c3ttp:route") : "@route requires @Route({ method, path }) on the handler";
	RouteConfig $config = $reflect(#handler).get_tag("c3ttp:route");
	return { $config.method, $config.path, &#handler };
}

// C3 custom attributes use type-style names (@Get, not @GET).
// Distinct tags allow multiple methods on one function. They are normalized
// to the same compile-time route triples as @Route during registration.
attrdef @Get(String path) = @tag("c3ttp:route:get", path);
attrdef @Post(String path) = @tag("c3ttp:route:post", path);
attrdef @Put(String path) = @tag("c3ttp:route:put", path);
attrdef @Delete(String path) = @tag("c3ttp:route:delete", path);
attrdef @Head(String path) = @tag("c3ttp:route:head", path);
attrdef @Options(String path) = @tag("c3ttp:route:options", path);
attrdef @Patch(String path) = @tag("c3ttp:route:patch", path);
attrdef @Connect(String path) = @tag("c3ttp:route:connect", path);
attrdef @Trace(String path) = @tag("c3ttp:route:trace", path);

// Capture containers live only for the handler call. Values borrow request.target.
// Only names[:count] and values[:count] are initialized and may be accessed.
const usz MAX_ROUTE_PARAMS = 8;
struct RouteParams
{
	String[MAX_ROUTE_PARAMS] names;
	String[MAX_ROUTE_PARAMS] values;
	usz count;
}

// Missing names are explicit faults; no decoding or numeric conversion is implicit.
macro String? RouteParams.get(&self, String name) => route_param_get_impl(self, name);

struct Server
{
	ViewHandler handler;
	void* context;
	ServerOptions options;
}

// Register the entire route set at compile time: no heap-backed route registry.
macro Server @server(...)
{
	$assert $vaarg.len > 0 : "@server requires at least one route";
	var $routes = @collect_routes(...$vaarg);
	return {
		.handler = fn void?(Request* request, Response* response, void* context) {
			return @dispatch(request, response, context, $routes);
		},
		.options = default_server_options(),
	};
}

macro void? Server.listen(&self, String host = "0.0.0.0", uint port = 8080)
	=> serve_impl(host, port, self.handler, self.context, self.options);

// path() and query() borrow the raw target; neither decodes nor allocates.
macro String RequestView.path(&self) => request_path_impl(self.target);
macro String RequestView.query(&self) => request_query_impl(self.target);
macro void ResponseView.text(&self, String body, ushort status = 200)
	=> response_view_set_impl(self, status, body, "text/plain; charset=utf-8");
// Accepts already serialized JSON; does not allocate or serialize.
macro void ResponseView.json(&self, String body, ushort status = 200)
	=> response_view_set_impl(self, status, body, "application/json");

// Individual setters preserve the other response fields and borrow the body.
macro void ResponseView.set_body(&self, String body) => self.body = body;
macro void ResponseView.set_status(&self, ushort status) => self.status = status;
