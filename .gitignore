# Editor files and Python caches
.idea/
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# C3 build products and standalone test/benchmark executables
build/
build-check/
out/
testrun
benchmarkrun

# Generated benchmark results, charts, and tables.
# Keep source, authored reports, and fixture project manifests versioned.
/benchmark/**/results/
/benchmark/**/*.json
!/benchmark/**/project.json
/benchmark/**/*.svg
/benchmark/**/*.png
/benchmark/**/tables.md
/benchmark/**/*-tables.md

# Transient benchmark workspaces and compiler output.
/benchmark/**/logs/
/benchmark/**/memory-logs/
/benchmark/**/tmp/
/benchmark/**/work/
/benchmark/**/plot-env/
/benchmark/**/*.log
/benchmark/**/*.o
/benchmark/**/*.a
/benchmark/**/*.so
/benchmark/**/*.bc
/benchmark/**/*.ll
/benchmark/**/server
/benchmark/**/parser
